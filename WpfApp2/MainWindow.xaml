<Window x:Class="WpfAppNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="work1" Height="480" Width="550" Background="#F0F4F8">
    <Canvas Margin="10">
        <Label Content="CY 6767" Canvas.Left="20" Canvas.Top="10" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A"/>
        <Label Content="視窗程式設計GOOD" Canvas.Left="200" Canvas.Top="16" FontSize="14" Foreground="#0D9488"/>

        <Label Content="姓名" Canvas.Left="20" Canvas.Top="60" Foreground="#1E293B" FontSize="14"/>
        <TextBox x:Name="txtName" Canvas.Left="80" Canvas.Top="62" Width="180" Height="25"/>

        <Label Content="電話" Canvas.Left="20" Canvas.Top="100" Foreground="#1E293B" FontSize="14"/>
        <TextBox x:Name="txtPhone" Canvas.Left="80" Canvas.Top="102" Width="180" Height="25"/>

        <Button Content="確認" Canvas.Left="290" Canvas.Top="62" Width="100" Height="65" Background="#2563EB" Foreground="White" FontSize="14" Click="BtnSubmit_Click"/>

        <Label Content="輸入一個數值" Canvas.Left="20" Canvas.Top="150" Foreground="#1E293B" FontSize="14"/>
        <TextBox x:Name="txtN" Canvas.Left="120" Canvas.Top="152" Width="140" Height="25"/>

        <Button Content="顯示N*N乘法表" Canvas.Left="290" Canvas.Top="150" Width="130" Height="30" Background="#059669" Foreground="White" FontSize="14" Click="BtnGenerate_Click"/>

        <Border Canvas.Left="20" Canvas.Top="200" Width="490" Height="210" Background="#E2E8F0" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                <TextBlock x:Name="tbResult" FontSize="13" Foreground="#0F172A"/>
            </ScrollViewer>
        </Border>
    </Canvas>
</Window>
